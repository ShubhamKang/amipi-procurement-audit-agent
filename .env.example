# Copy to .env and fill in. Never commit .env.
# LLM provider: gemini | mock   (mock = fully offline, no data leaves the machine)
LLM_PROVIDER=mock
GEMINI_API_KEY=
# Check the current free-tier model ID in Google AI Studio
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# Paths
DATA_DIR=Data
DB_PATH=runs/audit.db
